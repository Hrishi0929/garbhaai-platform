# Python
__pycache__/
*.pyc
.venv/
venv/

# Phase 8: both services/inference and training/drift_engine build their
# own FeatureStore purely in Python (no feature_store.yaml) and need a
# local sqlite registry + a dummy offline-store parquet to satisfy
# FileSource's validation -- see services/inference/feast_schema.py's
# docstring and training/drift_engine/detect_drift.py's get_feast_store().
# Neither is ever read for real data; both regenerate on first run.
feast_registry.db
feast_offline_placeholder.parquet

# training/drift_engine/compute_baseline.py's output (also re-logged to
# MLflow as the artifact of record -- these local copies are scratch)
training/drift_engine/outputs/
training/drift_engine/logs/

# training_engine/eval_engine output dirs (checkpoints/metrics -- the
# artifact of record lives in MLflow, same reasoning as above)
training/training_engine/outputs/

# OS cruft
.DS_Store

# Next.js UI build output / deps
services/ui-next/node_modules/
services/ui-next/.next/

# Local-only runtime data (databases, object store, DVC cache, generated manifest)
.dvc/tmp/
infra/local/.volumes/
infra/local/marquez/.volumes/
training/feature_repo/
training/data_quality/manifest.csv
