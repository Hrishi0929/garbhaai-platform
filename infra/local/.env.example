# Copy to .env in this folder if you want to override defaults.
# docker-compose.yml already has working defaults baked in for local dev,
# so this file is optional -- it exists so service code has one place to
# read connection settings from instead of hardcoding them.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=garbhaai
POSTGRES_PASSWORD=garbhaai_local_dev
POSTGRES_DB=garbhaai

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=garbhaai
MINIO_SECRET_KEY=garbhaai_local_dev
MINIO_BUCKET=garbhaai-images

REDIS_HOST=localhost
REDIS_PORT=6379
